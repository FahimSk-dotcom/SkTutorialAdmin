# Copy this file to .env.local for local development.
# Never commit .env.local or real credentials.

# Required in every environment
APP_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=sk_tutorials_staging
JWT_ADMIN_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-16-random-characters
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production database protection
PRODUCTION_DB_NAME=sk_tutorials
ALLOW_PRODUCTION_DB=false

# Initial admin provisioning (required when APP_ENV=production)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Required by parent authentication routes. Generate a separate random secret
# of at least 32 characters; never reuse JWT_ADMIN_SECRET or expose this value.
JWT_PARENT_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters

# Comma-separated exact browser origins allowed to call parent APIs.
# Include your Expo web origin locally and the published web origin in Vercel.
PARENT_APP_ORIGINS=http://localhost:8081

# Optional FCM and rate-limit configuration
FIREBASE_SERVICE_ACCOUNT=

# Assignments & Notes private storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MATERIAL_MAX_FILE_SIZE_MB=10
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Migration scripts only
PRODUCTION_MIGRATION_APPROVED=false
